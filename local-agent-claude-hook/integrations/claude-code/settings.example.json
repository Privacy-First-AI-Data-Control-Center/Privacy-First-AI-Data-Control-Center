{
  "$comment": "Copy the 'hooks' block below into ~/.claude/settings.json or your project's .claude/settings.json. Or simply run: npm run setup:hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:43127/hooks/claude-code",
            "headers": {
              "x-webhook-token": "replace-with-secure-local-webhook-token-min-16-chars"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:43127/hooks/claude-code",
            "headers": {
              "x-webhook-token": "replace-with-secure-local-webhook-token-min-16-chars"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:43127/hooks/claude-code",
            "headers": {
              "x-webhook-token": "replace-with-secure-local-webhook-token-min-16-chars"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:43127/hooks/claude-code",
            "headers": {
              "x-webhook-token": "replace-with-secure-local-webhook-token-min-16-chars"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:43127/hooks/claude-code",
            "headers": {
              "x-webhook-token": "replace-with-secure-local-webhook-token-min-16-chars"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
