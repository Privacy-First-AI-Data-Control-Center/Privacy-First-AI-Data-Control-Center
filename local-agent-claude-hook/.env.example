# Runtime environment: development | production | test
NODE_ENV=development

# Local HTTP receiver bind address (MUST be a loopback interface: 127.0.0.1, localhost, or ::1)
HOST=127.0.0.1

# Local HTTP receiver port for Claude Code hooks
PORT=43127

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Shared secret between Claude Code HTTP hooks and the local agent (min 16 characters)
LOCAL_WEBHOOK_TOKEN=replace-with-secure-local-webhook-token-min-16-chars

# Maximum webhook request payload size in bytes (default: 1048576 = 1 MB)
MAX_BODY_BYTES=1048576

# NestJS Backend API base URL
BACKEND_BASE_URL=http://127.0.0.1:3001/api/v1

# Local SQLite persistent queue path (use :memory: for in-memory tests)
SQLITE_DB_PATH=data/agent-queue.db

# Maximum pending events allowed in the local SQLite queue
QUEUE_MAX_CAPACITY=5000

# Local device identifier (replaced after device enrollment completes)
AGENT_DEVICE_ID=local-unregistered-device

